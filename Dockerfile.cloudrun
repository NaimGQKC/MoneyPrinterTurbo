# Cloud Run API server image.
# Starts the FastAPI/uvicorn server on port 8080 (the Cloud Run default).
# No system packages needed — Pedra and content_plan only use Python requests/httpx.

FROM python:3.11-slim-bullseye

WORKDIR /MoneyPrinterTurbo
RUN chmod 777 /MoneyPrinterTurbo

ENV PYTHONPATH="/MoneyPrinterTurbo"

# Install Python dependencies first so Docker cache is reused on code-only changes.
COPY requirements.txt ./
RUN pip install --no-cache-dir --retries 3 --timeout 60 -r requirements.txt

# Copy the full source tree.
COPY . .

# Create a default config.toml from the example so the app can start without
# a mounted volume. Cloud Run env vars can override individual settings.
RUN cp config.example.toml config.toml

# Cloud Run routes external traffic to $PORT (default 8080).
EXPOSE 8080

CMD ["python", "main.py"]
